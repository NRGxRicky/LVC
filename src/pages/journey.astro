---
/**
 * journey.astro — Luxury Voyage Collection
 * Filosofía / Historia de la marca
 */

import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Nuestra Filosofía — Luxury Voyage Collection"
  description="Creemos que viajar es la forma más elevada de arte. Nuestra filosofía sobre cómo entendemos el viaje."
>
  <Navbar theme="light" />

  <main class="w-full bg-[#FAF9F6] pt-32 md:pt-44 pb-28">
    
    <!-- HEADER FILOSOFÍA -->
    <section class="max-w-[900px] mx-auto px-6 md:px-12 text-center mb-12 md:mb-16">
      <span class="inline-block font-label text-[10px] md:text-xs font-bold text-[#775A19] uppercase tracking-[0.3em] mb-6 reveal-up">
        Nuestra Filosofía
      </span>
      <h1 class="font-heading text-4xl sm:text-5xl md:text-6xl text-[#1C1713] mb-8 leading-[1.15] tracking-tight reveal-up reveal-delay-100">
        La forma en que entendemos el viaje
      </h1>
      
      <div class="w-16 h-[1px] bg-[#D4AD65] mx-auto mb-8"></div>

      <div class="font-serif text-[#645D5A] leading-relaxed max-w-2xl mx-auto reveal-up reveal-delay-200 flex flex-col gap-3">
        <p class="text-lg sm:text-xl md:text-2xl italic text-[#1C1713]/90 font-light">
          Creemos que algunas experiencias permanecen mucho después del regreso.
        </p>
        <p class="text-sm sm:text-base italic text-[#775A19]/80 font-light">
          No por la cantidad de lugares visitados, sino por la forma en que fueron vividas.
        </p>
      </div>
    </section>

    <!-- IMAGEN CENTRAL -->
    <section class="max-w-[1100px] mx-auto px-6 mb-16 md:mb-24 reveal-up reveal-delay-300">
      <div class="relative overflow-hidden rounded-2xl shadow-[0_20px_50px_rgba(28,23,19,0.08)]">
        <img 
          src="https://garage-web.luxuryvoyageco.com/images/journey_hero.webp" 
          alt="La forma en que entendemos el viaje"
          class="w-full h-[400px] sm:h-[500px] md:h-[600px] object-cover select-none"
          draggable="false"
        />
      </div>
    </section>

    <!-- PÁRRAFOS EDITORIALES -->
    <section class="max-w-[760px] mx-auto px-6 md:px-8 text-center flex flex-col gap-10 md:gap-14 mb-24 md:mb-32 reveal-up">
      <p class="font-serif text-base sm:text-lg md:text-xl text-[#1C1713]/85 leading-relaxed md:leading-loose">
        Por eso valoramos el tiempo como uno de los recursos más importantes de cualquier viaje. La atención que puede ponerse en cada momento, la tranquilidad que nace cuando todo fluye con naturalidad y la confianza de saber que cada detalle ha sido considerado con cuidado.
      </p>

      <div class="w-12 h-[1px] bg-[#D4AD65]/40 mx-auto"></div>

      <p class="font-serif text-base sm:text-lg md:text-xl text-[#1C1713]/85 leading-relaxed md:leading-loose">
        Luxury Voyage Collection nace de esa convicción. De crear las condiciones necesarias para que la atención pueda dirigirse a lo verdaderamente importante: descubrir, observar, compartir y disfrutar.
      </p>

      <!-- DESTACADO EDITORIAL -->
      <div class="my-4 py-8 px-6 sm:px-10 border-y border-[#D4AD65]/30 bg-[#F5F2EA]/60 rounded-lg">
        <p class="font-serif text-lg sm:text-xl md:text-2xl text-[#775A19] italic leading-relaxed">
          "Porque cuando nada distrae de lo esencial, el viaje puede dedicarse a lo que realmente importa: ser vivido."
        </p>
      </div>

      <p class="font-serif text-lg sm:text-xl md:text-2xl text-[#1C1713] font-medium leading-relaxed italic">
        Y son precisamente esos momentos los que permanecen mucho después del regreso.
      </p>
    </section>

    <!-- TABLA DE VALORES -->
    <section class="w-full max-w-[1200px] mx-auto px-6 mb-12 md:mb-16 reveal-up">
      <div class="w-full border-t border-[#775A19]/20 pt-12 pb-12 flex flex-col items-center">
        <div class="text-[#D4AD65] text-xl mb-4">✦</div>
        <span class="block font-label text-[10px] md:text-xs font-bold text-[#775A19] uppercase tracking-[0.25em] mb-12 text-center">
          Lo que valoramos al viajar
        </span>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-8 lg:gap-6 items-stretch w-full border-b border-[#775A19]/20 pb-12">
          <!-- Columna 1 -->
          <div class="flex flex-col items-center text-center px-4 sm:border-r border-[#775A19]/15">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Criterio</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              Experiencia para distinguir aquello que realmente aporta valor.
            </p>
          </div>
          
          <!-- Columna 2 -->
          <div class="flex flex-col items-center text-center px-4 lg:border-r border-[#775A19]/15">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Tiempo</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              El recurso más valioso de cualquier viaje.
            </p>
          </div>
          
          <!-- Columna 3 -->
          <div class="flex flex-col items-center text-center px-4 sm:border-r border-[#775A19]/15">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Atención</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              La capacidad de dedicar presencia a cada momento.
            </p>
          </div>
          
          <!-- Columna 4 -->
          <div class="flex flex-col items-center text-center px-4 lg:border-r border-[#775A19]/15">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Tranquilidad</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              La confianza de saber que todo ha sido considerado con cuidado.
            </p>
          </div>
          
          <!-- Columna 5 -->
          <div class="flex flex-col items-center text-center px-4 sm:border-r border-[#775A19]/15">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Naturalidad</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              La sensación de que cada elemento fluye exactamente como debe hacerlo.
            </p>
          </div>
          
          <!-- Columna 6 -->
          <div class="flex flex-col items-center text-center px-4">
            <h4 class="font-label text-xs font-bold text-[#1C1713] uppercase tracking-[0.2em] mb-3">Confianza</h4>
            <p class="font-sans text-xs text-[#645D5A] leading-relaxed max-w-[180px]">
              La certeza de sentirse acompañado sin necesidad de preocuparse.
            </p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>
