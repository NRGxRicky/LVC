    </section>

    <!-- SECCIÓN 5: FORMULARIO DE CONSULTA DE COLECCIÓN -->
    <section class="w-full bg-[#FAF9F5] py-24 px-6 md:px-12 lg:px-20 border-t border-[#1C1713]/10 relative">
      <div class="max-w-[1280px] mx-auto reveal-up">
        
