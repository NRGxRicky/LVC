              <!-- Fila 2: WhatsApp y Correo -->
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- WhatsApp / Teléfono con Lada Internacional -->
                <div class="flex flex-col gap-2">
                  <label for="form-whatsapp" class="font-label text-[10px] uppercase tracking-[0.2em] font-bold text-[#1C1713]/50">WhatsApp / Teléfono *</label>
                  <div class="flex bg-[#FAF9F5] border border-[#1C1713]/10 rounded overflow-hidden focus-within:border-[#775A19]/50 transition-colors">
                    <select id="form-lada" name="lada" class="bg-[#EFECE6] border-r border-[#1C1713]/10 px-2 py-3 text-xs font-bold text-[#1C1713] focus:outline-none cursor-pointer shrink-0">
                      <option value="+52">🇲🇽 +52 (MX)</option>
                      <option value="+1">🇺🇸 +1 (US/CA)</option>
                      <option value="+57">🇨🇴 +57 (CO)</option>
                      <option value="+34">🇪🇸 +34 (ES)</option>
                      <option value="+54">🇦🇷 +54 (AR)</option>
                      <option value="+56">🇨🇱 +56 (CL)</option>
                      <option value="+51">🇵🇪 +51 (PE)</option>
                      <option value="+502">🇬🇹 +502 (GT)</option>
                      <option value="+506">🇨🇷 +506 (CR)</option>
                      <option value="+507">🇵🇦 +507 (PA)</option>
                      <option value="+593">🇪🇨 +593 (EC)</option>
                      <option value="+503">🇸🇻 +503 (SV)</option>
                      <option value="+504">🇭🇳 +504 (HN)</option>
                      <option value="+505">🇳🇮 +505 (NI)</option>
                      <option value="+598">🇺🇾 +598 (UY)</option>
                      <option value="+591">🇧🇴 +591 (BO)</option>
                      <option value="+595">🇵🇾 +595 (PY)</option>
                      <option value="+44">🇬🇧 +44 (UK)</option>
                      <option value="+33">🇫🇷 +33 (FR)</option>
                      <option value="+49">🇩🇪 +49 (DE)</option>
                      <option value="+39">🇮🇹 +39 (IT)</option>
                      <option value="+41">🇨🇭 +41 (CH)</option>
                    </select>
                    <input 
                      type="tel" 
                      name="whatsapp" 
                      id="form-whatsapp" 
                      placeholder="Número de 10 dígitos" 
                      required
                      class="w-full bg-transparent border-0 px-4 py-3 font-sans text-sm text-[#1C1713] focus:outline-none focus:ring-0"
                    />
                  </div>
                </div>

                <!-- Correo Electrónico -->
                <div class="flex flex-col gap-2">
                  <label for="form-email" class="font-label text-[10px] uppercase tracking-[0.2em] font-bold text-[#1C1713]/50">Correo Electrónico *</label>
                  <input 
                    type="email" 
                    name="email" 
                    id="form-email" 
                    placeholder="Escribe tu correo electrónico" 
                    required
                    class="w-full bg-[#FAF9F5] border border-[#1C1713]/10 px-4 py-3 rounded text-sm text-[#1C1713] focus:outline-none focus:border-[#775A19]/50 transition-colors"
                  />
