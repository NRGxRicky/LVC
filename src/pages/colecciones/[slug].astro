        </div>

      </div>
    </section>

    <!-- SUCCESS MODAL (Para confirmación de envío a HubSpot) -->
    <div 
      id="success-modal" 
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-500 px-6"
    >
      <div 
        id="success-modal-card" 
        class="bg-[#EDE7D7] border border-[#775A19]/25 w-full max-w-lg p-10 text-center shadow-2xl scale-95 transition-transform duration-500 relative"
      >
        <div class="text-[#775A19] text-3xl mb-4">✦</div>
        <h2 class="font-heading text-xl md:text-2xl text-[#1C1713] uppercase tracking-wider mb-2">Tu experiencia comienza aquí</h2>
        <div class="w-12 h-[1px] bg-[#D4AD65] mx-auto mb-4"></div>
        <p id="success-modal-message" class="font-sans text-xs md:text-sm text-[#1C1713]/80 leading-relaxed mb-6">
          Gracias por considerar a Luxury Voyage Collection para acompañarte en este viaje. Uno de nuestros Travel Designer ya ha comenzado a revisar la información que compartiste. En breve, se pondrá en contacto contigo para dar continuidad al diseño de tu experiencia.
        </p>
        <button
          type="button"
          id="close-success-modal"
          class="inline-flex font-label text-[10px] uppercase tracking-widest font-bold text-[#FAF9F6] bg-[#1C1713] hover:bg-[#775A19] transition-all duration-300 px-8 py-3.5 cursor-pointer rounded-[2px]"
        >
          Cerrar y Regresar
        </button>
      </div>
    </div>

  </main>

  <Footer />
</Layout>

<script>
  (() => {
    document.addEventListener('DOMContentLoaded', () => {
      // Populate dynamic future months (18 months ahead)
      const fechasSelect = document.getElementById('form-fechas') as HTMLSelectElement | null;
      if (fechasSelect) {
        const monthNames = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
        const now = new Date();
        const currentYear = now.getFullYear();
        const currentMonthIndex = now.getMonth();

        fechasSelect.innerHTML = '<option value="" disabled selected>Selecciona el mes aproximado</option>';

        for (let i = 0; i < 18; i++) {
          const targetDate = new Date(currentYear, currentMonthIndex + i, 1);
          const mName = monthNames[targetDate.getMonth()];
          const mYear = targetDate.getFullYear();
          const labelText = `${mName} ${mYear}`;
          
          const opt = document.createElement('option');
          opt.value = labelText;
          opt.textContent = labelText;
          fechasSelect.appendChild(opt);
        }
      }
    });

    const form = document.getElementById('collection-contact-form') as HTMLFormElement | null;
    const successModal = document.getElementById('success-modal');
    const successModalCard = document.getElementById('success-modal-card');
    const successModalMessage = document.getElementById('success-modal-message');
    const closeSuccessModalBtn = document.getElementById('close-success-modal');
    const submitBtn = document.getElementById('form-submit-btn');

    if (!form) return;

    function formatPhoneForHubSpot(rawInput: string, selectedLada: string = '+52'): string {
      if (!rawInput) return '';
      let lada = selectedLada ? selectedLada.trim() : '+52';
      if (!lada.startsWith('+')) {
        lada = '+' + lada.replace(/[^\d]/g, '');
      }
      let trimmed = rawInput.trim();
      if (trimmed.startsWith('+')) {
        const knownLadas = [
          '+506', '+502', '+503', '+504', '+505', '+598', '+591', '+595', '+593', '+507',
          '+52', '+57', '+34', '+54', '+56', '+51', '+44', '+33', '+49', '+39', '+41', '+1'
        ];
        const found = knownLadas.find(code => trimmed.startsWith(code));
        if (found) {
          lada = found;
          trimmed = trimmed.slice(found.length);
        } else {
          const match = trimmed.match(/^\+(\d{1,3})[\s-]*(.*)$/);
          if (match) {
            lada = '+' + match[1];
            trimmed = match[2];
          }
        }
      } else if (trimmed.startsWith('52') && trimmed.length >= 12) {
        lada = '+52';
        trimmed = trimmed.slice(2);
      }
      let digits = trimmed.replace(/[^\d]/g, '').replace(/^0+/, '');
      if (!digits) return lada;
      const ladaClean = lada.replace(/[^\d+]/g, '');
      // Standard E.164 without hyphens (+525586145716) ensures HubSpot CRM detects Country Code (+52 Mexico) and enables 1-click calls and WhatsApp
      return `${ladaClean}${digits}`;
    }

    const waEl = document.getElementById('form-whatsapp') as HTMLInputElement | null;
    if (waEl) {
      waEl.addEventListener('input', () => {
        const val = waEl.value;
        if (val.startsWith('+')) return;
        const digits = val.replace(/[^\d]/g, '').slice(0, 10);
        if (!digits) {
          waEl.value = '';
          return;
        }
        const area2 = ['55', '81', '33'];
        if (area2.includes(digits.slice(0, 2))) {
          if (digits.length <= 2) waEl.value = digits;
          else if (digits.length <= 6) waEl.value = `${digits.slice(0, 2)}-${digits.slice(2)}`;
          else waEl.value = `${digits.slice(0, 2)}-${digits.slice(2, 6)}-${digits.slice(6)}`;
        } else {
          if (digits.length <= 3) waEl.value = digits;
          else if (digits.length <= 6) waEl.value = `${digits.slice(0, 3)}-${digits.slice(3)}`;
          else waEl.value = `${digits.slice(0, 3)}-${digits.slice(3, 6)}-${digits.slice(6)}`;
        }
      });
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      console.log("✦ LVC: Enviando consulta de colección...");

      const nombreInput = document.getElementById('form-nombre') as HTMLInputElement | null;
      const emailInput = document.getElementById('form-email') as HTMLInputElement | null;
      const whatsappInput = document.getElementById('form-whatsapp') as HTMLInputElement | null;
      const ladaSelect = document.getElementById('form-lada') as HTMLSelectElement | null;
      const fechasInput = document.getElementById('form-fechas') as HTMLSelectElement | null;
      const viajerosInput = document.getElementById('form-viajeros') as HTMLSelectElement | null;
      const consideracionesInput = document.getElementById('form-consideraciones') as HTMLTextAreaElement | null;
      const coleccionInput = document.getElementById('form-coleccion') as HTMLInputElement | null;

      if (!nombreInput || !emailInput || !whatsappInput || !fechasInput || !viajerosInput || !consideracionesInput || !coleccionInput) {
        return;
      }

      const sanitize = (val: string) => val.replace(/</g, "&lt;").replace(/>/g, "&gt;");
      const nombre = sanitize(nombreInput.value.trim());
      const email = emailInput.value.trim();
      const rawWhatsapp = whatsappInput.value.trim();
      const lada = ladaSelect ? ladaSelect.value : '+52';
      const fechas = fechasInput.value;
      const viajeros = viajerosInput.value;
      const consideraciones = sanitize(consideracionesInput.value.trim()) || "Sin consideraciones adicionales";
      const coleccion = coleccionInput.value;

      const formattedPhone = formatPhoneForHubSpot(rawWhatsapp, lada);

      const compiledMessage = `--- DETALLES DEL VIAJE (DESDE COLECCIÓN) ---
• Colección de interés: ${coleccion}
• Fechas de viaje: ${fechas}
• Viajeros: ${viajeros}

--- CONSIDERACIONES ESPECIALES ---
${consideraciones}`;

      const nameParts = nombre.split(" ");
      const firstname = nameParts[0] || "";
      const lastname = nameParts.slice(1).join(" ") || "";

      // Enviar a HubSpot
      const portalId = import.meta.env.PUBLIC_HUBSPOT_PORTAL_ID || "51495057";
      const formId = import.meta.env.PUBLIC_HUBSPOT_COLLECTIONS_FORM_ID || import.meta.env.PUBLIC_HUBSPOT_FORM_ID || "b25257b0-7b1a-43b8-a591-fa2853b7a244";
      const endpoint = `https://api.hsforms.com/submissions/v3/integration/submit/${portalId}/${formId}`;

      const payload = {
        fields: [
          { name: "firstname", value: firstname },
          { name: "lastname", value: lastname },
          { name: "email", value: email },
          { name: "phone", value: formattedPhone },
          { name: "mobilephone", value: formattedPhone },
          { name: "message", value: compiledMessage }
        ],
        context: {
          pageUri: window.location.href,
          pageName: document.title
        }
      };

      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-70', 'cursor-not-allowed');
      }

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          console.error("HubSpot submission failed:", await response.text());
        }
      } catch (error) {
        console.error("Error submitting to HubSpot:", error);
      } finally {
        if (submitBtn) {
          submitBtn.removeAttribute('disabled');
          submitBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        }
      }

      // Mostrar modal de éxito
      if (successModalMessage) {
        successModalMessage.innerHTML = `Estimado(a) <strong>${nombre}</strong>, gracias por considerar a Luxury Voyage Collection para acompañarte en este viaje.<br/><br/>Uno de nuestros Travel Designer ya ha comenzado a revisar la información que compartiste. En breve, se pondrá en contacto contigo a través del medio que elegiste para dar continuidad al diseño de tu experiencia de la colección <strong>${coleccion}</strong>.`;
      }

      if (successModal && successModalCard) {
        successModal.classList.remove('opacity-0', 'pointer-events-none');
        successModal.classList.add('opacity-100');
        successModalCard.classList.remove('scale-95');
        successModalCard.classList.add('scale-100');
        document.body.style.overflow = "hidden";
      }
    });

    if (closeSuccessModalBtn && successModal && successModalCard) {
      closeSuccessModalBtn.addEventListener('click', () => {
        successModal.classList.remove('opacity-100');
        successModal.classList.add('opacity-0', 'pointer-events-none');
        successModalCard.classList.remove('scale-100');
        successModalCard.classList.add('scale-95');
        document.body.style.overflow = "";
        form.reset();
      });
    }
  })();
</script>

<style>
  /* Animación sutil de zoom en el hero image */
  @keyframes subtleZoom {
    0% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1.00);
    }
  }
  .animate-subtle-zoom {
    animation: subtleZoom 8s cubic-bezier(0.25, 1, 0.5, 1) forwards;
  }
</style>
