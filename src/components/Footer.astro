---
/**
 * Footer.astro — Navy & Gold Design System
 *
 * Footer estilo Honimunn: logo textual, listas de destinos/compañía,
 * columna de contacto con 3 ciudades y redes sociales circulares.
 * Fondo #F0EEE9 (navy más oscuro) para contraste con el resto de secciones.
 */

const destinations = [
  { label: "Asia", href: "/universos/asia" },
  { label: "África", href: "/universos/africa" },
  { label: "Europa", href: "/universos/europa" },
  { label: "Medio Oriente", href: "/universos/medio-oriente" },
  { label: "Colecciones Premium", href: "/colecciones" },
];

const company = [
  { label: "Nuestra Filosofía", href: "/journey" },
  { label: "Journal de Viaje", href: "/journal" },
  { label: "Aviso Legal", href: "/aviso-de-privacidad" },
];


const currentYear = new Date().getFullYear();
---

<footer id="footer" class="w-full bg-[#F0EEE9]" aria-label="Pie de página">
  <!-- Cuerpo principal del footer -->
  <div class="max-w-[1920px] mx-auto px-8 md:px-12 pt-20 pb-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8">
      <!-- Columna marca -->
      <div>
      <img
        src="https://garage-web.luxuryvoyageco.com/images/logo.webp"
        alt="Luxury Voyage Collection"
        class="h-20 w-auto object-contain mb-5 logo-footer"
        width="80"
        height="80"
        loading="lazy"
      />
        <p
          class="font-body text-sm text-[#1C1713]/50 leading-relaxed mb-8 max-w-[240px]"
        >
          Cada detalle tiene un propósito. Cada decisión, una razón de ser.
        </p>
        <!-- Redes sociales — Instagram & TikTok -->
        <div class="flex gap-3 relative z-20" aria-label="Redes sociales">
          <a
            href="https://www.instagram.com/luxuryvoyagecollection/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram de Luxury Voyage Collection"
            class="w-10 h-10 border border-[#D4AD65]/60 rounded-full flex items-center justify-center text-[#D4AD65] hover:bg-[#D4AD65] hover:text-white transition-all duration-300 relative z-20 cursor-pointer group"
          >
            <svg class="w-4 h-4 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
            </svg>
          </a>
          <a
            href="https://www.tiktok.com/@luxuryvoyageco"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="TikTok de Luxury Voyage Collection"
            class="w-10 h-10 border border-[#D4AD65]/60 rounded-full flex items-center justify-center text-[#D4AD65] hover:bg-[#D4AD65] hover:text-white transition-all duration-300 relative z-20 cursor-pointer group"
          >
            <svg class="w-4 h-4 fill-current group-hover:scale-110 transition-transform" viewBox="0 0 24 24">
              <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 1 1-5.2-1.74 2.89 2.89 0 0 1 2.31-1.22v-3.5a6.34 6.34 0 0 0-5.11 2.45 6.3 6.3 0 0 0 .1 7.9 6.34 6.34 0 0 0 7.7 1.47 6.3 6.3 0 0 0 3.75-5.75V9a8.27 8.27 0 0 0 4.77 1.54V7.05a4.85 4.85 0 0 1-1.1-.36z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Columna destinos -->
      <nav aria-label="Destinos">
        <h4
          class="font-label uppercase tracking-[0.25em] text-xs text-[#D4AD65] mb-6"
        >
          Destinos
        </h4>
        <div class="flex flex-col gap-3">
          {
            destinations.map((link) => (
              <a
                href={link.href}
                class="font-body text-sm text-[#1C1713]/50 hover:text-[#D4AD65] transition-colors duration-300"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Columna compañía -->
      <nav aria-label="Compañía">
        <h4
          class="font-label uppercase tracking-[0.25em] text-xs text-[#D4AD65] mb-6"
        >
          Compañía
        </h4>
        <div class="flex flex-col gap-3">
          {
            company.map((link) => (
              <a
                href={link.href}
                class="font-body text-sm text-[#1C1713]/50 hover:text-[#D4AD65] transition-colors duration-300"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Columna contacto con oficinas — clave en Honimunn -->
      <div>
        <h4
          class="font-label uppercase tracking-[0.25em] text-xs text-[#D4AD65] mb-6"
        >
          Contacto
        </h4>
        <div class="flex flex-col gap-3">
          <a
            href="mailto:contacto@luxuryvoyageco.com"
            class="font-body text-sm text-[#1C1713]/50 hover:text-[#D4AD65] transition-colors duration-300 block"
          >
            contacto@luxuryvoyageco.com
          </a>
          <a
            href="tel:+525611877271"
            class="font-body text-sm text-[#1C1713]/50 hover:text-[#D4AD65] transition-colors duration-300 block"
          >
            +52 56 1187 7271
          </a>
          <a
            href="https://maps.app.goo.gl/Gwi39cmRfYGBFxq37"
            target="_blank"
            rel="noopener noreferrer"
            class="font-body text-sm text-[#1C1713]/50 hover:text-[#D4AD65] transition-colors duration-300 block leading-relaxed"
            title="Ver ubicación en Google Maps"
          >
            C. Orizaba 154, Roma Nte., Cuauhtémoc, 06700 Ciudad de México, CDMX
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div
    class="border-t border-white/5 px-8 md:px-12 py-6 max-w-[1920px] mx-auto flex flex-col md:flex-row justify-between items-center gap-3"
  >
    <p class="font-label text-xs text-[#1C1713]/30">
      © {currentYear} Luxury Voyage Collection · Todos los derechos reservados.
    </p>
    <div class="flex gap-6">
      <a
        href="/aviso-de-privacidad"
        class="font-label text-xs text-[#1C1713]/30 hover:text-[#D4AD65] transition-colors duration-300"
        >Privacidad</a
      >
      <a
        href="/terminos-y-condiciones"
        class="font-label text-xs text-[#1C1713]/30 hover:text-[#D4AD65] transition-colors duration-300"
        >Términos</a
      >
      <a
        href="#cookies"
        id="open-cookies"
        class="font-label text-xs text-[#1C1713]/30 hover:text-[#D4AD65] transition-colors duration-300"
        >Cookies</a
      >
    </div>
  </div>
</footer>

<style>
  .logo-footer {
    mix-blend-mode: multiply;
    filter: brightness(1.05);
  }
</style>
